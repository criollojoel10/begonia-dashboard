#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Share the host uplink with begonia over the USB gadget (NAT).
# Idempotent; installed by begonia-usb-nat.service.
set -euo pipefail
IFACE=${IFACE:-enp4s0f3u2}   # host name of the phone's ECM gadget
UPLINK=${UPLINK:-wlan0}
NET=172.16.42.0/24

case "${1:-up}" in
up)
    sysctl -qw net.ipv4.ip_forward=1
    iptables -C FORWARD -i "$IFACE" -j ACCEPT 2>/dev/null ||
        iptables -I FORWARD 1 -i "$IFACE" -j ACCEPT
    iptables -C FORWARD -o "$IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null ||
        iptables -I FORWARD 1 -o "$IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    iptables -t nat -C POSTROUTING -s "$NET" -o "$UPLINK" -j MASQUERADE 2>/dev/null ||
        iptables -t nat -A POSTROUTING -s "$NET" -o "$UPLINK" -j MASQUERADE
    ;;
down)
    iptables -D FORWARD -i "$IFACE" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o "$IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    iptables -t nat -D POSTROUTING -s "$NET" -o "$UPLINK" -j MASQUERADE 2>/dev/null || true
    ;;
esac
